{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenti-site",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Create the KV namespace with: npx wrangler kv namespace create WAITLIST
  // Then replace the id below with the returned namespace ID
  "kv_namespaces": [
    {
      "binding": "WAITLIST",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
